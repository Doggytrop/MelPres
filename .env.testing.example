# Copy this file to .env.testing before running PHPUnit.
# Create the database and limited user first.
# Never reuse production/development credentials and never use root.

APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=melpres_test
DB_USERNAME=melpres_test_user
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
